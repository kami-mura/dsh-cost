{
  "name": "dsh-cost-log",
  "version": "0.1.7",
  "description": "DSH 原生插件：按 DeepSeek 峰谷价格表实时计算当前对话花费，并显示在输入框旁",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "tests",
    "README.en.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "cost",
    "token",
    "pricing",
    "peak-valley",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kami-mura/dsh-cost.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
